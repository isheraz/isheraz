# GitHub Integration
# Create a Personal Access Token with `read:user` permissions
# Classic token works better
# GitHub Data
GITHUB_TOKEN="your_github_personal_access_token_with_repo_scope"
GITHUB_USERNAME="isheraz"

# Supabase Auth & Data API
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key"

# Stripe Integration (Required for Admin dynamic pricing sync)
STRIPE_SECRET_KEY="sk_test_..."

# Google Analytics 4
# Measurement ID from Analytics → Admin → Data streams (starts with G-).
# Set this in the Vercel project environment after deploy. Do not commit a real ID here.
# In GA Admin, set the web stream URL to https://www.isheraz.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
